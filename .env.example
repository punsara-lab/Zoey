# ---------------------------------------------------------------------------
# ZOEY · .env.example
# Copy this file to .env and fill in the keys you need.
# ---------------------------------------------------------------------------

# ── LLM API ─────────────────────────────────────────────────────────────────
# Get an OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── ElevenLabs Voice (optional, higher quality than Piper) ─────────────────
# Get a key from: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=nOFQHZdNpigGDXFng9Rt

# ── Offline Text-to-Speech ─────────────────────────────────────────────────
# "piper" is the default and ships with this repo. "pyttsx3" = system voice.
TTS_PROVIDER=piper
PIPER_EXE=./piper/piper.exe
PIPER_MODEL=./piper/en_US-amy-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
PIPER_SENTENCE_SILENCE=0.2

# ── Local Brain (Ollama / llama.cpp / any OpenAI-compatible server) ────────
# Install Ollama from: https://ollama.com   then:  ollama pull gemma3:1b
LOCAL_BRAIN_FIRST=false
LOCAL_BRAIN_ENABLED=true
LOCAL_BRAIN_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_BRAIN_MODEL=gemma3:1b
LOCAL_BRAIN_MODEL_PATH=./zoey-g31b-j1/zoey.Q4_K_M.gguf

# ── Offline Mode ───────────────────────────────────────────────────────────
# Set to 1 to never leave the machine (requires LOCAL_BRAIN_ENABLED above).
OFFLINE_MODE=0

# ── Privacy ────────────────────────────────────────────────────────────────
# PRIVACY_MODE: "local" | "hybrid"
PRIVACY_MODE=hybrid
PRIVACY_BLOCK_WEB=0
ENCRYPT_MEMORY=0

# ── Microphone ─────────────────────────────────────────────────────────────
MIC_ENABLED=0
MIC_DEVICE_INDEX=1

# ── Phone Bridge (optional, Termux / WebSocket) ────────────────────────────
PHONE_BRIDGE_ENABLED=0
PHONE_BRIDGE_TOKEN=
PHONE_BRIDGE_HOST=127.0.0.1
PHONE_BRIDGE_PORT=8765

# ── Chat server binding ────────────────────────────────────────────────────
CHAT_HOST=127.0.0.1
CHAT_PORT=8765
